{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qpeer-api-dev.qpeer-api.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qpeer-api-dev.qpeer-api.workers.dev"
      }
    },
    "demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qpeer-api-demo.qpeer-api.workers.dev"
      }
    },
    "production": {
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
