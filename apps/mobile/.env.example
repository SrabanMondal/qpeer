# Copy to .env.local (gitignored) and fill in real values.
# EXPO_PUBLIC_* values are inlined into the JS bundle, so never put secrets here.

# Base URL of the QPeer API (Cloudflare Worker). Defaults to the dev Worker
# when unset. EAS build profiles set this in eas.json.
EXPO_PUBLIC_API_URL=https://qpeer-api-dev.qpeer-api.workers.dev

# Mapbox public access token (starts with "pk."). Without it the Map check
# screen shows a message instead of the map.
EXPO_PUBLIC_MAPBOX_TOKEN=

# OAuth "Web client" ID from the Firebase project (Authentication > Google, or
# Google Cloud Console > Credentials). Needed for Google sign-in; without it the
# button shows "not configured yet".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
