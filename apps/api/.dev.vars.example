# Local development environment variables for apps/api
FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
ENVIRONMENT=dev
# Optional: only if Expo push security ("enhanced security") is enabled.
# EXPO_ACCESS_TOKEN=
# Optional: Ed25519 private JWK that signs offline tickets (C3). Without it no
# ticket is signed. Make one with `npm run ticket-keys:gen` (repo root).
# TICKET_SIGNING_KEY='{"kty":"OKP","crv":"Ed25519","d":"…","x":"…","kid":"…"}'
# Optional: extra public JWK set still accepted during a key rotation.
# TICKET_PUBLIC_KEYS='{"keys":[]}'
