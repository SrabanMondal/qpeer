{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpeer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qpeer-local",
      "database_id": "local-db",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE",
        "class_name": "QueueDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueueDO"]
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "qpeer-f6dbe",
    "ENVIRONMENT": "local"
  },
  // Must match the expressions in src/cron/jobs.ts.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qpeer-dev",
          "database_id": "a9adedc6-eaec-475d-9b4c-0e11773cd9c0",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE",
            "class_name": "QueueDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["QueueDO"]
        }
      ],
      "vars": {
        "FIREBASE_PROJECT_ID": "qpeer-f6dbe",
        "ENVIRONMENT": "dev"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    },
    "demo": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qpeer-demo",
          "database_id": "59f9618a-3eb3-4463-9fdb-4adde061f6b2",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE",
            "class_name": "QueueDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["QueueDO"]
        }
      ],
      "vars": {
        "FIREBASE_PROJECT_ID": "qpeer-f6dbe",
        "ENVIRONMENT": "demo"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    },
    // Step 3.5 load test: Worker qpeer-api-loadtest. Test-only auth needs the
    // LOADTEST_JWKS secret; pushes are recorded, never sent (expo-push.ts).
    "loadtest": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qpeer-loadtest",
          "database_id": "12cf4f5a-8cc0-4894-8dfc-762c8c900579",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "QUEUE",
            "class_name": "QueueDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["QueueDO"]
        }
      ],
      "vars": {
        "FIREBASE_PROJECT_ID": "qpeer-f6dbe",
        "ENVIRONMENT": "loadtest"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  }
}
