{
  "name": "qpeer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/loadtest && tsc -p scripts/ticket-keys",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "loadtest:gen-key": "node scripts/loadtest/gen-key.ts",
    "ticket-keys:gen": "node scripts/ticket-keys/gen-key.ts",
    "loadtest:baseline": "node scripts/loadtest/run.ts --preset baseline --notes",
    "loadtest:full": "node scripts/loadtest/run.ts --preset full --notes",
    "loadtest:reset": "node scripts/loadtest/reset.ts",
    "loadtest:smoke:local": "node scripts/loadtest/run.ts --preset smoke --local --base-url http://127.0.0.1:8787"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "@firebase/util": false,
    "protobufjs": false,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
